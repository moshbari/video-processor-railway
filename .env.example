# Server Configuration
PORT=3000
NODE_ENV=production

# Railway Volume Path (persistent storage)
VOLUME_PATH=/app/data

# Video Processing Limits
MAX_VIDEO_SIZE_MB=1024
MAX_DURATION_SECONDS=1800
CLEANUP_AFTER_HOURS=24
CONCURRENT_JOBS=2

# Allowed Platforms (comma-separated)
ALLOWED_PLATFORMS=youtube,instagram,tiktok,facebook,twitter,vimeo

# Redis Configuration (Railway will provide this)
REDIS_URL=redis://localhost:6379

# OpenAI API Key (for transcription)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: 11Labs API Key (for text-to-speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Temp Directory
TEMP_DIR=/app/temp
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/outputs
